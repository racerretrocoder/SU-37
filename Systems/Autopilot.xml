  <pid-controller>
  <name>System Command: Yaw</name>
  <debug>false</debug>
    <enable>
 <condition>
  <or>
      <equals>
	<property>/autopilot/locks/altitude</property>
	<value>rudder-mode</value>
	</equals>
        <equals>
	<property>/autopilot/locks/altitude</property>
	<value>agl-hold-rudder</value>
	</equals>
  </or>
   </condition>
    </enable>
  <input>
   <property>/orientation/pitch-deg</property>
       <scale><prop>/fdm/jsbsim/fcs/ruddercoeff</prop></scale>
  </input>
  <reference>

   <prop>/autopilot/internal/target-yaw-deg</prop>
    <scale><prop>/fdm/jsbsim/fcs/ruddercoeff</prop></scale>
  </reference>
  <output>

   <property>/controls/flight/rudder</property>
  </output>
  <config>
   <Kp>-0.05</Kp>      
   <beta>1.0</beta>    <!-- input value weighing factor -->
   <alpha>0.1</alpha>  <!-- low pass filter weighing factor -->
   <gamma>0.0</gamma>  <!-- input value weighing factor for -->
   <Ti>2.0</Ti>       <!-- integrator time  10.0 -->
   <Td>0.00001</Td>    <!-- derivator time -->
      <u_min>	<value>-1</value>       </u_min> <!-- minimum output clamp -->
      <u_max><value>1</value>         </u_max>  <!-- maximum output clamp -->

  </config>
 </pid-controller> 


